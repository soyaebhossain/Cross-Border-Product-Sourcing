# Local-development defaults. Production refuses these placeholder secrets.
CATALOG_ENVIRONMENT=development

POSTGRES_DB=cross_border
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-only-postgres-password

CATALOG_JWT_SECRET=dev-only-not-for-production-change-me
CATALOG_CORS_ORIGINS=http://localhost:3000
CATALOG_FRONTEND_URL=http://localhost:3000
CATALOG_SECURE_COOKIES=false
CATALOG_GOOGLE_CLIENT_ID=
CATALOG_GOOGLE_CLIENT_SECRET=
CATALOG_MFA_ENCRYPTION_KEY=
CATALOG_PRIVILEGED_MFA_REQUIRED=true
CATALOG_MEDIA_PATH=
CATALOG_REQUEST_LOG_LEVEL=INFO
CATALOG_ERROR_MONITORING_DSN=
CATALOG_ERROR_MONITORING_ENVIRONMENT=
CATALOG_ERROR_MONITORING_TRACES_SAMPLE_RATE=0.05
CATALOG_RELEASE_VERSION=
CATALOG_NOTIFICATION_SENDER_NAME=SourceAI
CATALOG_NOTIFICATION_DISPATCH_BATCH_SIZE=50
CATALOG_SMTP_HOST=
CATALOG_SMTP_PORT=587
CATALOG_SMTP_USERNAME=
CATALOG_SMTP_PASSWORD=
CATALOG_SMTP_FROM_EMAIL=
CATALOG_SMTP_STARTTLS=true
CATALOG_SMS_WEBHOOK_URL=
CATALOG_SMS_API_TOKEN=
CATALOG_SMS_SENDER_ID=
CATALOG_WHATSAPP_WEBHOOK_URL=
CATALOG_WHATSAPP_API_TOKEN=
CATALOG_WHATSAPP_SENDER_ID=
CATALOG_PAYMENT_PROOF_ALLOWED_HOSTS=
CATALOG_SUPPLY_CHAIN_CSV_PATH=/data/supply_chain_data.csv

# Next.js server/proxy target. Browser requests stay relative to the storefront.
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=
